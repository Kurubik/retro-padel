{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@shared/*": [
        "./shared/*"
      ],
      "@client/*": [
        "./client/src/*"
      ]
    }
  },
  "include": [
    "client/src/**/*.ts",
    "shared/**/*.ts",
    "server/**/*.ts",
    "tests/**/*.ts",
    "vite.config.ts",
    "vite.server.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-server",
    "artifacts"
  ]
}
